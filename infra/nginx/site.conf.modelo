# Site do nginx do HOST. O deploy.sh preenche {{DOMINIO}}, {{PORTA}} e o bloco
# de TLS, que é montado a partir do certificado já existente para o domínio.
#
# Só este arquivo fala com a internet; os containers escutam em 127.0.0.1.
#
# A arquitetura nova é de ORIGEM ÚNICA: a SPA, /api e /gateway saem todos do
# mesmo domínio, servidos pelo container `web`. Por isso um site substitui os
# dois anteriores (front e API em domínios separados).

server {
    listen 80;
    listen [::]:80;

    server_name {{DOMINIO}};

    # O certbot usa este caminho para o desafio HTTP-01.
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

{{REDIRECT_HTTPS}}
}

{{BLOCO_TLS_INICIO}}
server {
{{LISTEN_TLS}}

    server_name {{DOMINIO}};

    ssl_certificate {{CERT_FULLCHAIN}};
    ssl_certificate_key {{CERT_KEY}};

{{OPCOES_SSL}}

    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:{{PORTA}};

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_http_version 1.1;

        # Conciliação e relatórios de marketplace demoram; o padrão de 60s corta.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
{{BLOCO_TLS_FIM}}
