# Ambiente de PRODUÇÃO. Copie para .env.production na VPS e preencha.
# NUNCA versione este arquivo preenchido.
#
#   cp .env.production.example .env.production
#
# O `deploy.sh preparar` gera sozinho os segredos marcados como [gerado].

# --- Rede -------------------------------------------------------------------

# Porta local onde o container web escuta. Só 127.0.0.1 — o nginx do host é
# quem publica. O deploy.sh escolhe uma livre se você não definir.
APP_PORT=8090

# Domínio público, sem protocolo. Ex.: willians.zfxsoftware.com.br
PUBLIC_HOST=

# URL pública completa. É ela que vai nas redirect_uri dos marketplaces, e
# precisa bater EXATAMENTE com o que estiver cadastrado no portal de cada um.
APP_PUBLIC_URL=

# Origens liberadas no CORS. Com origem única, basta a própria URL pública.
FRONTEND_ORIGINS=

# --- Segredos [gerado] ------------------------------------------------------

SECRET_KEY_BASE=
POSTGRES_PASSWORD=
SERVICE_API_TOKEN=
AR_ENCRYPTION_PRIMARY_KEY=
AR_ENCRYPTION_DETERMINISTIC_KEY=
AR_ENCRYPTION_KEY_DERIVATION_SALT=

# --- OMIE -------------------------------------------------------------------

OMIE_APP_KEY=
OMIE_APP_SECRET=

# ATENÇÃO: com `true`, o sistema GRAVA na contabilidade do cliente (baixas,
# títulos, transferências). Deixe vazio até validar em simulação.
OMIE_ALLOW_WRITES=

OMIE_CLIENTE_FORNECEDOR_ID=
OMIE_CONTA_CORRENTE_ID=
OMIE_CONTA_CORRENTE_DESTINO_ID=
OMIE_CATEGORIA_TRANSITORIA_RECEITA=
OMIE_CATEGORIA_TRANSITORIA_DESPESA=

# --- Marketplaces e Tiny ----------------------------------------------------
#
# Podem ficar vazios aqui: a tela de Configurações grava as chaves cifradas no
# banco, por empresa. O que estiver aqui vale como padrão do servidor.

ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_INGERIR_FATURAMENTO=

SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REGION=

AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_APP_ID=
AMAZON_REGION=
AMAZON_APP_DRAFT=

TINY_TOKEN=
TINY_API_VERSION=

# Deixe vazio em produção: com `true`, o sistema inventa vendas.
MARKETPLACE_SIMULATION=
