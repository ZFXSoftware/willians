# Constrói a SPA e serve como arquivo estático, junto com o proxy para a API e
# o gateway. Um container, uma porta — é o que o nginx do host consome.
#
# O contexto é a RAIZ do repositório, porque a configuração do nginx vive em
# infra/.
FROM node:22 AS build

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./

# Caminhos RELATIVOS: em produção tudo sai da mesma origem, e o nginx deste
# mesmo container encaminha /api ao Rails e /gateway ao gateway.
#
# Não deixe vazio. O client.ts faz `import.meta.env.VITE_API_URL || "http://
# localhost:3053"`, e string vazia é falsy em JavaScript — o build embutiria
# localhost:3053 na SPA, que é o que o navegador do usuário tentaria chamar.
ENV VITE_API_URL="/api"
ENV VITE_GATEWAY_URL="/gateway"

RUN npm run build

FROM nginx:alpine

COPY infra/nginx/app.conf /etc/nginx/conf.d/default.conf

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
