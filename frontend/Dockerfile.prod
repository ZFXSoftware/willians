# Constrói a SPA e serve como arquivo estático, junto com o proxy para a API e
# o gateway. Um container, uma porta — é o que o nginx do host consome.
#
# O contexto é a RAIZ do repositório, porque a configuração do nginx vive em
# infra/.
FROM node:22 AS build

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./

# Vazias de propósito: em produção o front fala por caminho relativo, mesma
# origem, sem CORS.
ENV VITE_API_URL=""
ENV VITE_GATEWAY_URL=""

RUN npm run build

FROM nginx:alpine

COPY infra/nginx/app.conf /etc/nginx/conf.d/default.conf

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
