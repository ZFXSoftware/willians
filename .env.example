# Copie para .env na raiz do projeto e preencha. O .env NÃO é versionado.
#
#   cp .env.example .env
#
# O docker compose lê este arquivo automaticamente.
# Sem OMIE_APP_KEY/OMIE_APP_SECRET o sistema usa os clientes de simulação.

# --- Obrigatório para subir ------------------------------------------------

# O container do backend roda com o seu usuário para não criar arquivos como
# root no diretório montado. Preencha com a saída de `id -u` e `id -g`.
USER_ID=1000
GROUP_ID=1000

# Chaves da aplicação criada no Portal do Desenvolvedor do OMIE.
OMIE_APP_KEY=
OMIE_APP_SECRET=

# ATENÇÃO: com `true`, o sistema passa a GRAVAR no OMIE do cliente
# (IncluirContaReceber, LancarRecebimento). Mantenha vazio para testar
# apenas leitura.
OMIE_ALLOW_WRITES=

# DEFAULT de último recurso para os códigos do OMIE.
#
# Uma empresa no OMIE tem vários clientes/fornecedores e várias contas
# correntes — normalmente um par por marketplace. A configuração real vive no
# metadata, e estas variáveis só valem quando nada mais foi definido:
#
#   platform_account.metadata > tenant.metadata > ENV
#
# Chaves aceitas no metadata: omie_cliente_fornecedor_id,
# omie_conta_corrente_id e omie_categorias (hash por tipo de lançamento).
# Use `bin/rails omie:settings` para ver o que está resolvido e o que falta.
OMIE_CLIENTE_FORNECEDOR_ID=
OMIE_CONTA_CORRENTE_ID=

# --- Marketplaces -----------------------------------------------------------

# Permite que contas SEM credencial caiam no provider de SIMULAÇÃO, que gera
# lançamentos fictícios. Ligado por padrão só em development/test. Nunca ligue
# em produção: dados simulados entrariam no ledger como se fossem reais.
MARKETPLACE_SIMULATION=

# --- Autenticação -----------------------------------------------------------

# Credencial máquina-a-máquina: como o scheduler roda sem usuário logado, é ela
# que autentica worker/scheduler no Rails. Gere um valor longo e aleatório:
#   openssl rand -hex 32
# Nunca entregue este token ao frontend.
SERVICE_API_TOKEN=

# Origens autorizadas a chamar a API pelo browser (separadas por vírgula).
# Vazio usa os defaults de desenvolvimento (localhost:5173 e localhost:3050).
# Atrás do proxy de origem única isto deixa de ser necessário.
FRONTEND_ORIGINS=

# --- Acesso público (túnel / proxy) ----------------------------------------
#
# O serviço `proxy` junta frontend, /api e /gateway na porta 8080. Exponha com:
#
#   ngrok http 8080 --domain=SEU-DOMINIO.ngrok-free.dev
#
# O plano free do ngrok dá um domínio estático permanente — use-o, porque a
# redirect_uri registrada no Mercado Livre precisa bater exatamente e não pode
# mudar a cada reinício do túnel.

# Domínio público, SEM protocolo. Libera o host no Rails e no Vite.
PUBLIC_HOST=

# URL pública completa, COM https. É a base da redirect_uri do OAuth.
APP_PUBLIC_URL=

# Caminhos relativos quando o frontend é servido pelo proxy. Deixe vazio para
# rodar direto em localhost:5173 (aí o front chama localhost:3053 e :3051).
VITE_API_URL=
VITE_GATEWAY_URL=

# --- Criptografia dos tokens de marketplace --------------------------------
#
# Os tokens de acesso dos marketplaces são cifrados no banco. Gere as chaves:
#
#   docker compose exec backend bin/rails db:encryption:init
#
# e copie os três valores para cá. SEM ELAS a conexão de marketplace não
# funciona. Trocar as chaves depois torna os tokens já gravados ilegíveis —
# guarde-as junto com os outros segredos de produção.
AR_ENCRYPTION_PRIMARY_KEY=
AR_ENCRYPTION_DETERMINISTIC_KEY=
AR_ENCRYPTION_KEY_DERIVATION_SALT=

# --- Mercado Livre ----------------------------------------------------------
#
# Credenciais do app registrado no portal de desenvolvedores do Mercado Livre.
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# Cadastre esta URL como redirect_uri no app do ML. Vazio usa
# APP_PUBLIC_URL + /api/integracoes/mercado-livre/callback.
# Precisa bater EXATAMENTE com a cadastrada lá.
ML_REDIRECT_URI=

# Ligue só se o app do ML estiver com o fluxo PKCE habilitado.
ML_USE_PKCE=

# Sobrescreva apenas se os hosts do ML forem diferentes dos padrões
# (auth.mercadolivre.com.br e api.mercadolibre.com).
ML_AUTH_HOST=
ML_API_HOST=

# --- Shopee -----------------------------------------------------------------
#
# Credenciais do app registrado no Shopee Open Platform. Diferente do Mercado
# Livre, a Shopee assina cada chamada com HMAC-SHA256 usando a partner_key —
# ela nunca trafega na requisição.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=

# Região do host: br (padrão), global ou cn. SHOPEE_HOST sobrescreve por
# completo, para apontar no sandbox.
SHOPEE_REGION=
SHOPEE_HOST=

# Cadastre esta URL como redirect no app da Shopee. Vazio usa
# APP_PUBLIC_URL + /api/integracoes/shopee/callback.
SHOPEE_REDIRECT_URI=

# Usuário inicial criado pelo `bin/rails db:seed`. Sem a senha definida, as
# seeds não criam usuário nenhum.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Amazon (Selling Partner API) -------------------------------------------
#
# Desde outubro de 2023 a SP-API NÃO exige mais AWS IAM nem assinatura SigV4 —
# basta o token LWA. Não é preciso criar nada na AWS.
#
# AMAZON_APP_ID é o Application ID do app no Seller Central (usado na tela de
# consentimento). CLIENT_ID/SECRET são as credenciais LWA.
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_APP_ID=

# Região do endpoint da SP-API: na (padrão, cobre o Brasil), eu ou fe.
# AMAZON_HOST sobrescreve por completo.
AMAZON_REGION=
AMAZON_HOST=

# Seller Central onde o vendedor autoriza. Padrão: sellercentral.amazon.com.br
AMAZON_CONSENT_HOST=

# Cadastre como redirect no app. Vazio usa
# APP_PUBLIC_URL + /api/integracoes/amazon/callback
AMAZON_REDIRECT_URI=
